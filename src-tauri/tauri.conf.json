{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Admin Pro",
  "version": "1.0.0",
  "identifier": "com.carlodandan.admin-pro",
  "build": {
    "beforeDevCommand": "pnpm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Admin Pro",
        "width": 1920,
        "height": 1080,
        "minWidth": 1200,
        "minHeight": 800,
        "resizable": true,
        "maximized": true,
        "visible": false,
        "center": true,
        "decorations": true,
        "backgroundColor": "#0F172A",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "img-src": "'self' asset: http://asset.localhost data: blob:",
        "font-src": "'self' data:",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "connect-src": "'self' ipc: http://ipc.localhost"
      },
      "assetProtocol": {
        "enable": false
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "copyright": "Copyright (c) Carlo Dandan",
    "category": "Business",
    "shortDescription": "Company Administration System",
    "longDescription": "Admin Pro - offline-first company administration system for employees, departments, attendance and Philippine bi-monthly payroll.",
    "publisher": "Carlo Dandan",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English"]
      }
    }
  }
}
